ENVIRONMENT=dev
LOGGING_LEVEL=DEBUG
JWT_SECRET=pass
GOOGLE_CLOUD_PROJECT=gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
LANGFUSE_DEBUG=true
# Local self-hosted Langfuse (docker compose up langfuse-web).
# The keys below match the LANGFUSE_INIT_* values in docker-compose.yml.
# Swap host/keys for your Langfuse Cloud project when needed.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_PUBLIC_KEY=pk-lf-local
# Local self-hosted GrowthBook (docker compose up growthbook).
# Create an SDK connection in the UI (http://localhost:3002) and paste its
# client key below; leave empty to disable feature flags (defaults apply).
GROWTHBOOK_API_HOST=http://localhost:3101
GROWTHBOOK_CLIENT_KEY=
